#!/bin/bash

set -euo pipefail

mode=${1:-install}
backup_suffix=.new-charter-backup

if [[ $mode != install && $mode != restore ]]; then
  echo "Usage: brand-limine [install|restore]" >&2
  exit 2
fi

mapfile -t candidates < <(find /boot -maxdepth 3 -type f -name 'limine.conf' -print)

if (( ${#candidates[@]} == 0 )); then
  echo "No Limine configuration was found under /boot; nothing changed."
  exit 0
fi

changed=0
for config in "${candidates[@]}"; do
  backup="${config}${backup_suffix}"

  if [[ $mode == install ]]; then
    if grep -q '^interface_branding: Omarchy Bootloader$' "$config"; then
      [[ -e $backup ]] || cp --archive -- "$config" "$backup"
      sed -i 's/^interface_branding: Omarchy Bootloader$/interface_branding: New Charter/' "$config"
      echo "Updated $config (backup: $backup)"
      changed=1
    elif grep -q '^interface_branding: New Charter$' "$config"; then
      echo "Already branded: $config"
      changed=1
    fi
  elif [[ -f $backup ]] && grep -q '^interface_branding: New Charter$' "$config"; then
    cp --archive -- "$backup" "$config"
    echo "Restored $config from $backup"
    changed=1
  fi
done

if (( changed == 0 )); then
  echo "Limine configuration found, but no applicable branding change was needed."
fi
