#!/bin/bash

# New Charter presentation wrapper for all Omarchy maintenance terminals.
source /usr/share/omarchy/bin/omarchy-restart-gum

cmd="$*"
presentation_script="omarchy-show-logo; $cmd; if (( \$? != 130 )); then omarchy-show-done; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="New Charter" -e bash -c "$presentation_script"
